# Set to true to route development requests through the Vite remote proxy.
VITE_PULSE_REMOTE=false

# Development-server-only values. Do not prefix these with VITE_.
# TAUTULLI_REMOTE_URL=https://tautulli.example.com
# TAUTULLI_API_KEY=replace-with-a-development-api-key

# Set only when connecting to a development instance with an untrusted TLS cert.
TAUTULLI_REMOTE_INSECURE=false
